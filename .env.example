SESSION_SECRET=
FIELD_ENCRYPTION_KEY=   # 64 hex chars (32 bytes) for AES-256-GCM phone encryption
PHONE_INDEX_KEY=        # HMAC key for the phone blind index (uniqueness per tenant)
PAYMOB_HMAC_SECRET=     # Paymob dashboard > Settings > HMAC
PAYMOB_SECRET_KEY=      # empty = local sandbox simulator
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_CARD=
PAYMOB_INTEGRATION_WALLET=
PAYMOB_INTEGRATION_KIOSK=
WHATSAPP_TOKEN=         # empty = messages are simulated and shown in the dashboard outbox
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=    # used to verify X-Hub-Signature-256 on the webhook
WHATSAPP_VERIFY_TOKEN=
DEFAULT_TENANT_SLUG=basma   # tenant served on localhost / the platform host
ROOT_DOMAIN=localhost       # <slug>.ROOT_DOMAIN resolves a tenant by subdomain
PUBLIC_BASE_URL=            # optional, used for absolute URLs in messages
DATABASE_PATH=              # default ./data/clinic.db
